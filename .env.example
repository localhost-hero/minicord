# Go backend
BACKEND_ADDR=:8080

# LiveKit values. For local development, use ws://localhost:7880. For a public
# deployment behind Caddy, set this to the browser-reachable LiveKit URL, for
# example wss://vc.minicord.kz or wss://livekit.example.com.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-local-key
LIVEKIT_API_SECRET=replace-with-local-secret

# Frontend. For local development the default is http://localhost:8080. Behind
# Caddy, point this to the public site origin such as https://vc.minicord.kz.
VITE_API_URL=http://localhost:8080

# Required administrator account. Generate ADMIN_PASSWORD_HASH with bcrypt and
# SESSION_SECRET with a cryptographically random value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional public site domain used by the reverse proxy.
PUBLIC_SITE_DOMAIN=vc.minicord.kz
